# =============================================================================
# EMS Production .env — IIS Server 151.50.1.114 (Windows Server 2012 R2)
# Location: C:\inetpub\wwwroot\EMS\backend\.env
# After changes: pm2 restart EMS-API --update-env
#
# Server PDF requires: puppeteer@19.4.0 + Chrome 109 (NOT Puppeteer 24 / Chrome 146)
# Install: helpers\fix_puppeteer_pdf_ws2012.bat
# =============================================================================

# --- Database ---
DB_USER=bmsuser
DB_PASSWORD="Ems@Bms#76979"
DB_SERVER=151.50.1.116
DB_DATABASE=EMS_DB

# --- API (PM2 listens here; IIS :81 proxies /api and /uploads) ---
PORT=5002
EMS_PUBLIC_API_URL=http://151.50.1.114:81

# --- SMTP (enquiry notifications from server) ---
SMTP_HOST=almoayyedcg-com.mail.protection.outlook.com
SMTP_PORT=25
SMTP_USER=ems@almoayyedcg.com
SMTP_PASS="acg@76979#"
SMTP_ENCRYPTION=STARTTLS
SMTP_IPV4=1

# --- File attachments (PM2 user needs Modify on UNC path) ---
ENQUIRY_ATTACHMENTS_ROOT=\\151.50.20.129\ems app

# --- Enquiry email (Outlook COM does not work under PM2) ---
EMS_ENQUIRY_NOTIFY_VIA_SMTP=1
EMS_ENQUIRY_NOTIFY_SMTP_FALLBACK=1

# --- Outlook local helper (runs on each user's PC, not on server) ---
EMS_OUTLOOK_HELPER_PORT=39281

# --- Quote PDF (server-side Puppeteer) ---
EMS_QUOTE_PDF_SERVER_ENABLED=1
# Puppeteer on server uses loopback — NOT the IIS URL :81
QUOTE_PDF_ASSET_ORIGIN=http://127.0.0.1:5002
QUOTE_PDF_USE_FILE_LOAD=1
QUOTE_PDF_SINGLE_PROCESS=0
PUPPETEER_LAUNCH_TIMEOUT_MS=180000
QUOTE_PDF_PAGE_TIMEOUT_MS=180000
EMS_QUOTE_PDF_PERF_LOG=1
EMS_QUOTE_PDF_DEBUG_PAGINATION=1
QUOTE_PDF_RESTRICT=1

# --- Chrome 109 for Windows Server 2012 R2 ---
# Do NOT use npx puppeteer browsers install chrome (installs Chrome 146).
# Do NOT use Edge (msedge.exe).
PUPPETEER_CHROME_MILESTONE=109

# Portable Chromium (from fix_puppeteer_pdf_ws2012.bat / chrome-win-1069273.zip)
PUPPETEER_EXECUTABLE_PATH=C:\inetpub\wwwroot\EMS\backend\.cache\chromium-chrome109\chrome-win-1069273\chrome-win\chrome.exe

# If you used Google Chrome 109 offline installer instead, comment above and use:
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
