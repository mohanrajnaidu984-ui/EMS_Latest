<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <webSocket enabled="true" />
    <!--
      Socket.IO (ChatBox) uses path /api/socket.io so it rides the working API reverse-proxy
      (avoids standalone /socket.io timeouts that caused connect_error + backend disconnect storms).

      CRITICAL for instant chat + stable API:
      - ARR proxy timeout must be 00:05:00 (300s)
      - ARR responseBufferLimit must be 0 (otherwise Socket.IO long-polls buffer / timeout)
      - Node HTTP_KEEP_ALIVE_TIMEOUT_MS must be 310000+ (greater than ARR timeout)
      Optional: enable Windows "WebSocket Protocol" and set VITE_SOCKET_IO_WEBSOCKET=1.
    -->
    <security>
      <requestFiltering>
        <!-- 100 MB — must allow large enquiry attachments through IIS before Node/multer -->
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>
    <rewrite>
      <rules>
        <!-- Proxy API + Socket.IO (/api/socket.io) to Node.js Backend (PM2 EMS-API on :5002) -->
        <rule name="API Proxy" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://localhost:5002/api/{R:1}" appendQueryString="true" />
        </rule>

        <!-- Legacy Socket.IO path (older builds) — keep until all clients use /api/socket.io -->
        <rule name="Socket.IO Proxy Legacy" stopProcessing="true">
          <match url="^socket\.io(.*)" />
          <action type="Rewrite" url="http://localhost:5002/api/socket.io{R:1}" appendQueryString="true" />
        </rule>

        <!-- Express static logos/files (same as Vite dev proxy /uploads) -->
        <rule name="Uploads Proxy" stopProcessing="true">
          <match url="^uploads/(.*)" />
          <action type="Rewrite" url="http://localhost:5002/uploads/{R:1}" appendQueryString="true" />
        </rule>

        <!-- Handle React Router (SPA) -->
        <rule name="React Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/api/" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/socket\.io" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/uploads/" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
    <staticContent>
      <!-- remove-first avoids IIS 500 when MIME types already exist at server level -->
      <remove fileExtension=".json" />
      <remove fileExtension=".webp" />
      <remove fileExtension=".aff" />
      <remove fileExtension=".dic" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <mimeMap fileExtension=".aff" mimeType="text/plain" />
      <mimeMap fileExtension=".dic" mimeType="text/plain" />
    </staticContent>
  </system.webServer>
</configuration>
