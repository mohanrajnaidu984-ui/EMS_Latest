# IIS / production frontend build — users access http://151.50.1.114:81 (IIS proxies /api to Express :5002).
VITE_API_PORT=5002

# Leave empty to use same-origin relative /api (recommended for IIS on port 81).
# VITE_API_BASE=http://151.50.1.114:81

# PDF HTML asset base in browser — must match the URL users open (IIS port, not Express port).
VITE_SERVER_ORIGIN=http://151.50.1.114:81

# Server-side Puppeteer PDF download (not browser print)
VITE_QUOTE_PDF_BROWSER_DOWNLOAD=0

