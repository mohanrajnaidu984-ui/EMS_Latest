# IIS / production frontend build — users access http://151.50.1.38 (IIS proxies /api to Express :5002).
# Host: ACG-WEBSVR02 (151.50.1.38). PM2 as SYSTEM → UNC identity ACG-WEBSVR02$.
VITE_API_PORT=5002

# Leave empty to use same-origin relative /api (recommended for IIS).
# VITE_API_BASE=http://151.50.1.38

# PDF HTML asset base in browser — must match the URL users open (IIS, not Express :5002).
VITE_SERVER_ORIGIN=http://151.50.1.38

# Server-side Puppeteer PDF download (not browser print)
VITE_QUOTE_PDF_BROWSER_DOWNLOAD=0

# ChatBox — leave as 1 for normal use. Set to 0 and rebuild frontend to hide ChatBox / stop unread polls.
# TEMP DISABLED — disconnecting backend / high CPU; set both back to 1 and rebuild when ready
VITE_CHATBOX_ENABLED=0
VITE_CHATBOX_REALTIME=0
# Prefer polling behind IIS unless ARR WebSocket is proven: do not set VITE_SOCKET_IO_WEBSOCKET=1 on prod
